# ============================================================
# Docker Compose 环境配置
# ============================================================

# Elasticsearch 开关
# 本地开发 / 低内存(4G)环境：保持为空，不启动 ES，节省约 1GB 内存
# 服务器部署(8G+)：设为 search，启动 ES 全文检索功能
COMPOSE_PROFILES=search

# Spring Boot 应用是否启用 ES 同步（需与上面 COMPOSE_PROFILES 配合使用）
# COMPOSE_PROFILES=search 时设为 true，否则设为 false
BLOG_SEARCH_ENABLED=true
