# ============================================================
# 环境变量模板：复制为 .env 后按需修改（.env 不会提交到 git）
#   cp .env.example .env
# Docker Compose 与后端（application*.yaml 占位）共用这些变量。
# 未设置时均使用默认值；生产环境【必须】修改带 ★ 的项。
# ============================================================

# ---- Compose 行为 ----
# 启用的服务分组（search = 附带 Elasticsearch 全文检索；monitor = 附带 Prometheus + Grafana 监控；可组合如 search,monitor）
COMPOSE_PROFILES=search

# ---- 数据库（★生产必改）----
# MySQL root 密码（仅容器初始化与维护用途，后端应用不使用 root 连接）
MYSQL_ROOT_PASSWORD=123456
# 应用数据库名（仅首次建库时生效；已有数据卷的老部署请改回原库名 dlbyy_zp_blog）
MYSQL_DATABASE=dlbyy_z
# 后端连接 MySQL 的专用账号（仅首次建库时自动创建并授权；老部署请保持 root）
MYSQL_USERNAME=blog_app
# 专用账号密码（★生产必改为强密码，需与 mysql 侧一致）
MYSQL_PASSWORD=<强密码>
# MySQL 宿主机端口映射（格式 host_ip:host_port:container_port）：默认仅绑定本机回环（安全，不暴露公网）
# 远程连接数据库推荐使用 SSH 隧道（见 部署操作手册 9.8 节），保持默认回环绑定即可、无需修改本项；
# 仅内网环境且无法 SSH 时才改为 3306，并务必在安全组将来源限制为固定 IP
MYSQL_PORT=127.0.0.1:3306:3306

# ---- Redis（★生产必改）----
REDIS_PASSWORD=123456

# ---- 安全密钥（★生产必改为强随机值）----
# JWT 签名密钥：长度必须 ≥ 64 字符（HS512 硬校验，不足后端启动直接失败），使用 openssl rand -base64 64 生成并完整复制
# 注意：更换密钥后所有已登录用户的 Token 全部失效，需重新登录
JWT_SECRET=<openssl rand -base64 64 生成的强随机值>
# API 请求签名密钥：blog-admin 前端构建时自动从本变量注入（docker compose build blog-admin），与后端天然一致；
# 注意：修改本值后必须重建前端镜像：docker compose build blog-admin && docker compose up -d blog-admin blog-backend
API_SIGNING_SECRET=BlogApiSigningSecret2024!
# CORS 允许携带凭证的来源（逗号分隔，★生产必改为精确域名）
CORS_ALLOWED_ORIGINS=*
# Swagger API 文档开关（生产保持 false，需要联调排查时临时改 true）
SWAGGER_ENABLED=false

# ---- 监控（Grafana 管理员，启用 monitor 分组时生效）----
# ★生产必改：Grafana 登录密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin123

# ---- 功能开关 ----
# 是否启用 Elasticsearch 全文检索（true 需 COMPOSE_PROFILES 包含 search）
BLOG_SEARCH_ENABLED=true

# ---- OSS 对象存储（使用 oss 存储策略时填写）----
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_URL_PREFIX=https://your-bucket-name.oss-cn-hangzhou.aliyuncs.com/
